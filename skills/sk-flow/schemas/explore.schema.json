{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "0 - EXPLORE.md frontmatter",
	"type": "object",
	"required": ["schema", "slug", "next-step", "reason"],
	"additionalProperties": false,
	"properties": {
		"schema": { "enum": ["explore"] },
		"slug": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
		"next-step": {
			"enum": ["sk-alternatives", "sk-planning"],
			"description": "Recommended next skill: sk-alternatives when the approach is unclear, sk-planning when it is clear."
		},
		"reason": { "type": "string", "description": "One-line reason for the recommendation." }
	}
}
