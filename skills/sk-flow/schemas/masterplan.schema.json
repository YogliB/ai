{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "2 - PLANNING.md frontmatter (multi-PR masterplan)",
	"type": "object",
	"required": ["schema", "slug", "decision", "prs", "review"],
	"additionalProperties": false,
	"properties": {
		"schema": { "enum": ["masterplan"] },
		"slug": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
		"decision": {
			"enum": ["split"],
			"description": "Masterplans always carry the split decision."
		},
		"prs": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
			},
			"description": "Stable PR slugs, in execution order; must match the initiative runbook's prs keys."
		},
		"review": {
			"type": "object",
			"required": ["valid", "false-positive", "unvalidated"],
			"additionalProperties": false,
			"properties": {
				"valid": { "type": "integer", "minimum": 0 },
				"false-positive": { "type": "integer", "minimum": 0 },
				"unvalidated": { "type": "integer", "minimum": 0 }
			},
			"description": "sk-review-plan triage counts from the final pass; valid must be 0 to proceed."
		}
	}
}
