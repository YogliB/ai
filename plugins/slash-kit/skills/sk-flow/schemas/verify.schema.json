{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "5 - VERIFY.md frontmatter",
	"type": "object",
	"required": ["schema", "slug", "result", "receipts"],
	"additionalProperties": false,
	"properties": {
		"schema": { "enum": ["verify"] },
		"slug": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
		"result": {
			"enum": ["pass", "fail", "blocked"],
			"description": "pass/fail = verification steps ran; blocked = needs credentials/services the agent cannot reach."
		},
		"receipts": {
			"type": "array",
			"items": { "type": "string" },
			"description": "Paths to receipt files proving verification commands ran."
		}
	}
}
