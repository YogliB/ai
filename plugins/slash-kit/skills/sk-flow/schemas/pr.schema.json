{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "6 - PR.md frontmatter",
	"type": "object",
	"required": ["schema", "slug", "url", "status", "number"],
	"additionalProperties": false,
	"properties": {
		"schema": { "enum": ["pr"] },
		"slug": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
		"url": { "type": "string", "description": "Pull request URL." },
		"status": { "enum": ["open", "updated", "closed"], "description": "Last known PR status." },
		"number": {
			"type": "integer",
			"minimum": 0,
			"description": "PR number; 0 when not created."
		}
	}
}
